{
  "name": "ai-architecture-atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "extract": "tsx scripts/extract.ts && node scripts/build-search-index.mjs && tsx scripts/build-boot.ts",
    "extract:analyze": "node scripts/isolation-split-test.mjs && npm run extract",
    "dev": "tsx scripts/build-boot.ts && tsx scripts/build-runtime.ts && astro dev",
    "build": "tsx scripts/build-boot.ts && tsx scripts/build-runtime.ts && node scripts/build-og.mjs && astro build && node scripts/snapshot.mjs",
    "preview": "astro preview",
    "build:ai-test": "PUBLIC_AI_ENABLED=true ATLAS_OUT_DIR=dist-ai npm run build",
    "build:gh-test": "ATLAS_BASE=/aiatlas/ ATLAS_OUT_DIR=dist-gh npm run build",
    "test:e2e": "playwright test --trace off",
    "typecheck": "tsc --noEmit -p .",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "check:links": "tsx scripts/check-links.ts",
    "lighthouse": "node scripts/lighthouse.mjs",
    "inventory": "node scripts/inventory.mjs",
    "inventory:isolation": "node scripts/isolation-split-test.mjs",
    "inventory:coverage": "node scripts/render-coverage.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "esbuild": "^0.28.2",
    "lighthouse": "^12.8.2",
    "node-html-parser": "^6.1.13",
    "playwright": "1.63.0",
    "satori": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^5.18.2"
  }
}
