# Copy to .env for local builds. On Cloudflare Pages, set these as environment variables.
# Never put secrets in PUBLIC_* variables: they are compiled into the client.

# AI features (Ask the Atlas, infographic generation, eval generation, …).
# false (default): every AI button stays hidden. true: calls go to PUBLIC_AI_ENDPOINT.
PUBLIC_AI_ENABLED=false
# PUBLIC_AI_ENDPOINT=/api/claude
# Cloudflare Turnstile site key (public). Set together with TURNSTILE_SECRET on the proxy
# to require a bot check on AI requests. The widget loads only on the first AI request.
# PUBLIC_TURNSTILE_SITE_KEY=

# Canonical site URL, used for canonical links, sitemap and OG tags (Phase 4).
PUBLIC_SITE_URL=https://example.com

# Plausible analytics domain. Leave unset to omit the script.
# PUBLIC_PLAUSIBLE_DOMAIN=
# PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Contact address used by the footer, About, Privacy and Terms (overrides src/data/site.json).
# PUBLIC_CONTACT_EMAIL=

# ---- AI proxy (functions/api/claude.ts; Cloudflare Pages secrets/variables, not PUBLIC_) ----
# See docs/ai-proxy.md. Never commit real values.
# ANTHROPIC_API_KEY=            (secret)
# IP_HASH_SALT=                 (secret)
# TURNSTILE_SECRET=             (secret, optional)
# CLAUDE_MODEL_DEFAULT=claude-opus-5-5
# CLAUDE_MODEL_QUICK=claude-haiku-5-5
# CLAUDE_EFFORT=low
# SITE_ORIGIN=https://your.domain
# RATE_LIMIT_PER_HOUR=20
# RATE_LIMIT_PER_DAY=100
# DAILY_REQUEST_CAP=500
