---
// DRAFT for review — TODO(Rakesh): review every section, decide the governing law, set the contact
// address in src/data/site.json, then remove "terms" from draftPages in src/data/site.json.
import SimpleLayout from '../layouts/SimpleLayout.astro';
import { BASE, CONTACT_EMAIL, SITE_CONFIG } from '../lib/site';
const draft = SITE_CONFIG.draftPages.includes('terms');
---
<SimpleLayout id="terms" title="Terms" description="Terms of use for the AI Architecture Atlas: educational content, licences, no warranty." noindex={draft} canonicalPath={`${BASE}terms/`}>
  <div class="legal">
  {draft && <p class="draft-note">Draft, under review</p>}
  <span class="kicker">Site</span>
  <h1>Terms of use</h1>
  <p class="lead">The AI Architecture Atlas is free educational material about how AI systems are designed and run. Using the site means you accept these terms.</p>

  <h2>Educational content only</h2>
  <p>Everything on the site is general information for learning. It is <b>not</b> legal, regulatory, compliance, security, financial or investment advice, and it is not a substitute for advice from a qualified professional about your situation. Calculators, estimators, scorecards and generated documents use the numbers you enter and simplified models; check results before relying on them.</p>

  <h2>No warranty</h2>
  <p>The site is provided "as is", without warranties of any kind, express or implied, including accuracy, completeness, fitness for a particular purpose and non-infringement. AI technology, products, standards and regulations change quickly; pages show a "last reviewed" date where content is time-sensitive. To the extent the law allows, {SITE_CONFIG.owner} is not liable for any loss arising from use of the site.</p>

  <h2>AI-generated output</h2>
  <p>Where AI features are enabled, answers and drafts are generated by a model and can be wrong. Review them before use. Do not enter confidential or personal information.</p>

  <h2>Licences</h2>
  <ul>
    <li>Content (text, diagrams and data) is licensed under <a href={SITE_CONFIG.contentLicence.url} rel="license noopener" target="_blank">{SITE_CONFIG.contentLicence.name}</a>: you may share and adapt it for non-commercial purposes with attribution to {SITE_CONFIG.owner} and a link to the source page.</li>
    <li>The site's source code is licensed under the <a href={SITE_CONFIG.codeLicence.url} rel="noopener" target="_blank">{SITE_CONFIG.codeLicence.name} licence</a>.</li>
    <li>Product and company names are trademarks of their owners and appear as examples only, not endorsements.</li>
  </ul>

  <h2>Links to other sites</h2>
  <p>Source and reference links lead to sites the Atlas does not control and is not responsible for.</p>

  <h2>Views</h2>
  <p>Views are the author's own and not those of any employer, client or vendor.</p>

  <h2>Changes and governing law</h2>
  <p>These terms may change; the current version is always on this page. {/* TODO(Rakesh): governing law and jurisdiction. */}</p>

  <h2>Contact</h2>
  <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> · <a href={`${BASE}privacy/`}>Privacy</a></p>
  <p class="muted">Last updated: {/* TODO(Rakesh): date of approval */}draft.</p>
  </div>
</SimpleLayout>
