---
// A redirect for hosts without server-side redirects (GitHub Pages). On Cloudflare/Netlify,
// public/_redirects answers these paths first.
interface Props { to: string; title: string }
const { to, title } = Astro.props;
// JSON with '<' escaped, so no value can close the script element (instead of define:vars).
const js = `location.replace(${JSON.stringify(to).replace(/</g, '\\u003c')});`;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{title} · AI Architecture Atlas</title>
<meta name="robots" content="noindex">
<link rel="canonical" href={to}>
<meta http-equiv="refresh" content={`0; url=${to}`}>
<script is:inline set:html={js}></script>
</head>
<body><p>This page moved to <a href={to}>{title}</a>.</p></body>
</html>
