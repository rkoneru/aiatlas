---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/site.css';
import atlasCss from '../styles/atlas.css?raw';
import nav from '../data/nav.json';
import bootUrl from '../generated/boot.js?url';
import { BASE, pageContent, companionHTML, type PageMeta } from '../lib/site';
import Sidebar from '../components/Sidebar.astro';
import { seo, SITE_NAME } from '../lib/seo';
// Per-page runtimes built by scripts/build-runtime.ts (Phase 3); the infographic studio loads on demand.
const RUNTIMES = import.meta.glob('../generated/runtime/*.js', { query: '?url', import: 'default', eager: true }) as Record<string, string>;

interface Props { page: PageMeta }
const { page } = Astro.props;
const meta = seo(page);
const title = meta.title;
const runtimeUrl = RUNTIMES[`../generated/runtime/${page.id}.js`];
const infographicUrl = RUNTIMES['../generated/runtime/infographic.js'];
if (!runtimeUrl || !infographicUrl) throw new Error(`no runtime for ${page.id}: run scripts/build-runtime.ts`);
const content = pageContent(page.id);
const companions = companionHTML(page.id);
---
<!DOCTYPE html>
<html lang="en" data-page={page.id} data-base={BASE} data-ig={infographicUrl}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={meta.description}>
<link rel="canonical" href={meta.url}>
{meta.noindex && <meta name="robots" content="noindex">}
<meta property="og:type" content={meta.ogType}>
<meta property="og:site_name" content={SITE_NAME}>
<meta property="og:title" content={title}>
<meta property="og:description" content={meta.description}>
<meta property="og:url" content={meta.url}>
<meta property="og:image" content={meta.image}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={`${title}`}>
<meta property="og:locale" content="en">
{meta.modified && <meta property="article:modified_time" content={meta.modified}>}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={meta.description}>
<meta name="twitter:image" content={meta.image}>
{meta.jsonLd.map((j) => <script is:inline type="application/ld+json" set:html={JSON.stringify(j).replace(/</g, '\\u003c')} />)}
<link rel="icon" href={`${BASE}favicon.ico`} sizes="48x48">
<link rel="icon" href={`${BASE}favicon-32.png`} type="image/png" sizes="32x32">
<link rel="icon" href={`${BASE}favicon-128.png`} type="image/png" sizes="128x128">
<link rel="apple-touch-icon" href={`${BASE}apple-touch-icon.png`}>
<link rel="manifest" href={`${BASE}site.webmanifest`}>
<meta name="theme-color" content="#0b1f4d">
<!-- The Atlas stylesheet stays in a <style> element: the diagram, slide and proposal exporters copy it from there. -->
<style is:inline data-atlas set:html={atlasCss}></style>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="app">
<Sidebar />

<main id="main" tabindex="-1">
<Fragment set:html={nav.shell.coursebar} />
<section id={page.id} style={`--accent:var(--${page.accent})`}><Fragment set:html={content} /></section>
</main>
</div>
<div id="atlas-companions" hidden inert aria-hidden="true"></div>
{companions && <template id="atlas-companions-tpl"><Fragment set:html={companions} /></template>}
<!-- Deferred: same order and still before DOMContentLoaded, without blocking first paint. -->
<script is:inline defer src={bootUrl}></script>
<script is:inline defer src={runtimeUrl}></script>
</body>
</html>
